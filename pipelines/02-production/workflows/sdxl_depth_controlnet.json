{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load checkpoint (SDXL base 1.0)" },
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive prompt (shot visual_prompt + bible style_prompt)" },
    "inputs": { "text": "REPLACED_BY_CLIENT", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative prompt (bible negative_prompt)" },
    "inputs": { "text": "REPLACED_BY_CLIENT", "clip": ["4", 1] }
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": { "title": "Depth pass from Blender" },
    "inputs": { "image": "REPLACED_BY_CLIENT" }
  },
  "11": {
    "class_type": "ControlNetLoader",
    "_meta": { "title": "Load depth ControlNet" },
    "inputs": { "control_net_name": "controlnet-depth-sdxl-1.0-small.safetensors" }
  },
  "12": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": { "title": "Apply depth (locks the previs layout)" },
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "control_net": ["11", 0],
      "image": ["10", 0],
      "strength": 0.6,
      "start_percent": 0.0,
      "end_percent": 0.8
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Canvas 1344x768" },
    "inputs": { "width": 1344, "height": 768, "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "Sampler (fixed seed for repeatability)" },
    "inputs": {
      "seed": 420891,
      "steps": 30,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" },
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save keyframe" },
    "inputs": { "filename_prefix": "tcc_keyframe", "images": ["8", 0] }
  }
}
