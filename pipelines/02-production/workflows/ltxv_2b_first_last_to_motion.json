{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load motion model (LTX-Video 2B 0.9.8 distilled, fp8; VAE inside)"
    },
    "inputs": {
      "ckpt_name": "ltxv-2b-0.9.8-distilled-fp8.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load text encoder (T5 XXL, fp8)"
    },
    "inputs": {
      "clip_name": "t5xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive prompt (shot action + camera move)"
    },
    "inputs": {
      "text": "REPLACED_BY_CLIENT",
      "clip": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative prompt"
    },
    "inputs": {
      "text": "worst quality, inconsistent motion, blurry, jittery, distorted, morphing faces, extra fingers, watermark, text, subtitles, logo",
      "clip": [
        "2",
        0
      ]
    }
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Approved first frame",
      "tcc_guide": "first"
