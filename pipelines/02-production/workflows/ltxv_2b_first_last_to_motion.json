    "inputs": {
      "image": "REPLACED_BY_CLIENT"
    }
  },
  "6": {
    "class_type": "LTXVPreprocess",
    "_meta": {
      "title": "Soften the still the way video frames look"
    },
    "inputs": {
      "image": [
        "5",
        0
      ],
      "img_compression": 35
    }
  },
  "7": {
    "class_type": "LTXVImgToVideo",
    "_meta": {
      "title": "832x480, length set per shot (8n+1 frames at 24 fps)"
