    "inputs": {
      "positive": [
        "3",
        0
      ],
      "negative": [
        "4",
        0
      ],
      "vae": [
        "1",
        2
      ],
      "image": [
        "6",
        0
      ],
      "width": 832,
      "height": 480,
      "length": 97,
      "batch_size": 1,
      "strength": 1.0
    }
  },
  "8": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Approved last frame (optional: removed when the shot has none)",
      "tcc_guide": "last"
    },
    "inputs": {
      "image": "REPLACED_BY_CLIENT"
    }
  },
  "9": {
    "class_type": "LTXVPreprocess",
